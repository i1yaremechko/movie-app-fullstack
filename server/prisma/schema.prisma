generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  email      String?  @unique
  name       String?
  avatarUrl  String?
  googleId   String?  @unique
  telegramId String?  @unique
  createdAt  DateTime @default(now())

  favorites Favorite[]
  comments  Comment[]
  feedbacks Feedback[]
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  tmdbId      Int
  mediaType   String   // "movie" | "tv"
  title       String
  posterPath  String?
  releaseDate String?
  voteAverage Float?
  genreIds    Int[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId, mediaType])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  mediaType String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tmdbId, mediaType])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  name      String?
  email     String?
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}